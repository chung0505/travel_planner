spring.application.name=travel-planner

# PostgreSQL
spring.datasource.url=jdbc:postgresql://localhost:5432/traveldb
spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.username=travel
spring.datasource.password=travel123

spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

server.port=8080

# OpenRouteService API Key
# 免費申請：https://openrouteservice.org
ors.api-key=YOUR_ORS_API_KEY
